# Normalize line endings INSIDE the repository to LF, regardless of OS.
# Windows working copies still get CRLF on checkout; git converts on the way in.
#
# Why this matters: CI and the Docker build run on Linux. A .sh or a Dockerfile
# checked in with CRLF fails there with "bad interpreter: /bin/bash^M" — an error
# that is very hard to read the first time you meet it.
* text=auto eol=lf

# Windows-only files keep CRLF
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Never touch these
*.png   binary
*.jpg   binary
*.ico   binary
*.pfx   binary
*.snk   binary
