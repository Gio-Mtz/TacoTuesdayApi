<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <!-- SQLite, so the unique index that decides duplicates is a real one. The EF Core
         in-memory provider does not enforce indexes, which would make the duplicate test
         pass against a store that has no constraint behind it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TacoTuesday.SharedKernel\TacoTuesday.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Modules\TacoTuesday.Modules.Candidates\TacoTuesday.Modules.Candidates.csproj" />
    <ProjectReference Include="..\..\src\Modules\TacoTuesday.Modules.Leads\TacoTuesday.Modules.Leads.csproj" />
  </ItemGroup>

</Project>