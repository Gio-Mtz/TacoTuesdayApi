<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TacoTuesday.SharedKernel\TacoTuesday.SharedKernel.csproj" />
    <ProjectReference Include="..\TacoTuesday.Infrastructure\TacoTuesday.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\TacoTuesday.Modules.Candidates\TacoTuesday.Modules.Candidates.csproj" />
    <ProjectReference Include="..\Modules\TacoTuesday.Modules.Companies\TacoTuesday.Modules.Companies.csproj" />
    <ProjectReference Include="..\Modules\TacoTuesday.Modules.Leads\TacoTuesday.Modules.Leads.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- The provider lives in the host, not in the module. This is the only project in the
         solution that knows the waiting list is on SQL Server. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Design-time only: this is what `dotnet ef` needs to build the model. PrivateAssets
         keeps it out of the published container image. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="TacoTuesday.IntegrationTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
