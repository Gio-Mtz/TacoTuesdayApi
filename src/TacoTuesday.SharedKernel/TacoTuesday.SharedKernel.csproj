<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- SharedKernel hosts the IEndpoint convention, so it needs the ASP.NET Core
         types. This is a deliberate, documented exception: it is the ONLY project
         besides Api and the modules that touches the web framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Scrutor" />
  </ItemGroup>

</Project>
